# GEMINI_API_KEY: Optional if AI features are explicitly enabled.
GEMINI_API_KEY=""

# APP_URL: Public URL of the hosted application.
APP_URL="http://localhost:3000"

# PRODUCTION DEPLOYMENT (Cloudflare Pages Secrets / Environment Variables)
# Configure these directly in Cloudflare Pages -> Settings -> Variables & Secrets (or backend secrets manager).
# Never commit real secret values to GitHub.
WALLET_JWT_SECRET=""
WALLET_REFRESH_SECRET=""
WALLET_PIN_PEPPER=""
WALLET_FIELD_ENCRYPTION_KEY=""
WALLET_SIGNED_URL_SECRET=""

# CLOUD DATABASE SYNC (Firebase Firestore Service Account JSON)
# Paste single-line JSON credentials for real-time cross-device cloud persistence on Node & Cloudflare Workers.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# SUPER ADMIN BOOTSTRAP
# The first Super Admin email allowed instant root Back-Office privileges in Production.
SUPER_ADMIN_EMAIL="comfort.designszw@gmail.com"

# CLOUDFLARE PAGES API PROXY / CLIENT BASE URL
# Set API_ORIGIN as a Cloudflare Pages env var pointing to your backend API (e.g. https://api.comfortwallet.zw)
# Or set VITE_API_BASE_URL at Vite build time if calling a cross-origin API directly.
API_ORIGIN=""
VITE_API_BASE_URL=""

# PostgreSQL (Docker / Production)
DATABASE_URL="postgresql://wallet_app:wallet_pass@localhost:5432/comfort_wallet"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# S3-Compatible Private Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="comfort-wallet-private-kyc"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Notification Adapters (Africa's Talking SMS, Resend/SES Email, Web Push VAPID)
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID="COMFORTPAY"
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
